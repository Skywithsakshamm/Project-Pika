# Selvie Environment Configuration
USER_NAME=Saksham
ASSISTANT_NAME=Selvie
PORT=8765
HOST=127.0.0.1

# AI & LLM Settings
# Providers: ollama | cloud | rules
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Optional Cloud LLM (Gemini / OpenAI compatible)
CLOUD_API_KEY=
CLOUD_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CLOUD_MODEL=gemini-1.5-flash

# Speech & Voice Settings
# Indian Female Voices: en-IN-NeerjaExpressiveNeural, en-IN-NeerjaNeural, hi-IN-SwaraNeural
TTS_VOICE=en-IN-NeerjaExpressiveNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz

# System & Automation
GLOBAL_HOTKEY=Ctrl+Space
AUTO_START_WINDOWS=true
QUIET_MODE=false
CONFIRMATION_REQUIRED=true
